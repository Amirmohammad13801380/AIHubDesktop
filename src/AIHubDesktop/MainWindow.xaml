<Window x:Class="AIHubDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Hub Desktop"
        Width="1150"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft">

    <Grid Margin="12">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- پنل تنظیمات -->
        <Border Grid.Column="0"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <TextBlock Text="AI Hub Desktop"
                               FontSize="24"
                               FontWeight="Bold" />

                    <TextBlock Text="اتصال یکپارچه به مدل‌های محلی و ابری"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,4,0,18" />

                    <Label Content="ارائه‌دهنده" />

                    <ComboBox x:Name="ProviderComboBox"
                              Height="38"
                              SelectionChanged="ProviderComboBox_OnSelectionChanged"
                              DisplayMemberPath="Name" />

                    <Label Content="آدرس API"
                           Margin="0,12,0,0" />

                    <TextBox x:Name="BaseUrlTextBox"
                             Height="38"
                             FlowDirection="LeftToRight"
                             HorizontalContentAlignment="Left" />

                    <Label Content="API Key"
                           Margin="0,12,0,0" />

                    <PasswordBox x:Name="ApiKeyPasswordBox"
                                 Height="38"
                                 FlowDirection="LeftToRight" />

                    <TextBlock x:Name="ApiKeyHelpText"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,6,0,0" />

                    <Button Content="ذخیرهٔ تنظیمات"
                            Click="SaveSettingsButton_OnClick"
                            Margin="0,12,0,0" />

                    <Button Content="دریافت مدل‌ها"
                            Click="LoadModelsButton_OnClick" />

                    <Button x:Name="OpenApiPageButton"
                            Content="صفحهٔ دریافت API Key"
                            Click="OpenApiPageButton_OnClick" />

                    <Separator Margin="0,14" />

                    <Label Content="مدل" />

                    <ComboBox x:Name="ModelComboBox"
                              Height="40"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              DisplayMemberPath="Name"
                              StaysOpenOnEdit="True" />

                    <TextBlock Text="اگر مدل در فهرست نبود، شناسهٔ آن را دستی وارد کنید."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,6,0,0" />

                    <Label Content="System Prompt"
                           Margin="0,14,0,0" />

                    <TextBox x:Name="SystemPromptTextBox"
                             Height="100"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="تو یک دستیار هوش مصنوعی دقیق و مفید هستی. به زبان کاربر پاسخ بده." />

                    <Separator Margin="0,14" />

                    <Button Content="گفتگوی جدید"
                            Click="NewChatButton_OnClick" />

                    <Button x:Name="StopButton"
                            Content="توقف پاسخ"
                            Background="#C94A4A"
                            Click="StopButton_OnClick"
                            IsEnabled="False" />

                    <TextBlock x:Name="StatusTextBlock"
                               Text="آماده"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,14,0,0" />

                </StackPanel>

            </ScrollViewer>

        </Border>

        <!-- پنل گفتگو -->
        <Grid Grid.Column="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8">

                <TextBox x:Name="TranscriptTextBox"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         FontSize="15"
                         BorderThickness="0"
                         Background="Transparent" />

            </Border>

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="105" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UserInputTextBox"
                         Grid.Column="0"
                         MinHeight="85"
                         MaxHeight="180"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontSize="15"
                         PreviewKeyDown="UserInputTextBox_OnPreviewKeyDown" />

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="ارسال"
                        FontSize="16"
                        FontWeight="Bold"
                        Margin="8,0,0,0"
                        Click="SendButton_OnClick" />

            </Grid>

        </Grid>

    </Grid>
</Window>
